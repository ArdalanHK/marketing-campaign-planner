{
  "name": "marketing-campaign-planner",
  "version": "0.1.0",
  "description": "A small, client-side tool that turns basic campaign information into a structured first-draft marketing plan.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
